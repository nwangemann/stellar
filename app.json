{
  "expo": {
    "name": "Stellar",
    "slug": "stellar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Stellar shows the sky overlay on top of your camera view.",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "bundleIdentifier": "com.nate.stellar"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stellar uses your location to work out which stars are above you and where true north is."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stellar uses motion sensors to show the part of the sky your phone points at."
        }
      ]
    ],
    "scheme": "stellar"
  }
}
